rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
        data.isAnonymous is bool &&
        data.educationLevel in ['explorer', 'middle_school', 'high_school', 'college', 'undergraduate', 'masters'] &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048));
    }

    // Validation for SavedExperiment
    function isValidSavedExperiment(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.simType is string && data.simType.size() <= 64 &&
        data.parameters is map &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000));
    }

    // Validation for SolvedProblemRecord
    function isValidSolvedProblem(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.problem is string && data.problem.size() > 0 && data.problem.size() <= 3000 &&
        data.summary is string && data.summary.size() <= 2000 &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 128)) &&
        (!('level' in data) || (data.level is string && data.level.size() <= 64)) &&
        (!('finalAnswer' in data) || (data.finalAnswer is string && data.finalAnswer.size() <= 500));
    }

    // Validation for QuizAttemptRecord
    function isValidQuizAttempt(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.score is number && data.score >= 0 &&
        data.totalQuestions is number && data.totalQuestions > 0 &&
        (!('domain' in data) || (data.domain is string && data.domain.size() <= 128)) &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 128)) &&
        (!('accuracy' in data) || (data.accuracy is number)) &&
        (!('level' in data) || (data.level is string && data.level.size() <= 64));
    }

    // Validation for SavedChat
    function isValidSavedChat(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        (!('domain' in data) || (data.domain is string && data.domain.size() <= 128)) &&
        (!('level' in data) || (data.level is string && data.level.size() <= 64)) &&
        data.messages is list && data.messages.size() <= 100;
    }

    // User document and personal isolated subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().diff(resource.data).affectedKeys().hasOnly(['educationLevel', 'displayName', 'photoURL', 'email', 'updatedAt', 'isAnonymous']);
      allow delete: if isOwner(userId);

      // User's private saved simulation setups
      match /savedExperiments/{experimentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedExperiment(incoming(), userId);
        allow update: if isOwner(userId) && isValidSavedExperiment(incoming(), userId) &&
          incoming().diff(resource.data).affectedKeys().hasOnly(['title', 'parameters', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // User's private saved AI chat conversations
      match /savedChats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedChat(incoming(), userId);
        allow update: if isOwner(userId) && isValidSavedChat(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // User's private solved problems notebook
      match /solvedProblems/{problemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSolvedProblem(incoming(), userId);
        allow update: if isOwner(userId) && isValidSolvedProblem(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // User's private quiz score attempts
      match /quizAttempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuizAttempt(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
